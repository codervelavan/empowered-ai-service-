# Production environment template — every variable fastapi_app/config.py
# actually reads. Copy to .env.production and fill in real values.
# Never commit the real file.

# ---- Auth (shared secrets — must match the callers' own tokens) ----
# The Portal's AI_SERVICE_TOKEN must equal PORTAL_AUTH_TOKEN below.
# Frappe's ai_service_token must equal FRAPPE_AUTH_TOKEN below.
SERVICE_AUTH_TOKEN=REPLACE-WITH-A-ROTATED-FALLBACK-TOKEN
PORTAL_AUTH_TOKEN=REPLACE-WITH-A-ROTATED-TOKEN
FRAPPE_AUTH_TOKEN=REPLACE-WITH-A-ROTATED-TOKEN

# ---- Portal webhook callback (async candidate-evaluation results) ----
PORTAL_CALLBACK_URL=https://app.empoweredcareers.ai/api/webhooks/ai-evaluation
PORTAL_CALLBACK_SECRET=REPLACE-WITH-A-ROTATED-SECRET

# ---- LLM provider ----
# PRODUCTION: use a paid OpenAI API key (not free OpenRouter).
# Model: gpt-4o-mini — confirmed to honor strict json_schema structured
# outputs that this service requires. Budget ~$100/mo for 500-user cohorts.
OPENAI_API_KEY=
# Leave blank for real OpenAI. Set to https://openrouter.ai/api/v1 to route
# through OpenRouter instead (whose keys start `sk-or-v1-`) — not recommended
# for production.
OPENAI_BASE_URL=
AI_PROVIDER=real
OPENAI_SPECIALIST_MODEL=gpt-4o-mini
OPENAI_CONSOLIDATION_MODEL=gpt-4o-mini
# Retried once, only on a structured-output compliance failure. See
# evaluation.py's _json_completion. Optionally upgrade to gpt-4o if primary
# fails schema compliance in production logs.
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ---- Redis (external managed instance — no bundled container here) ----
REDIS_URL=redis://USER:PASSWORD@YOUR-MANAGED-REDIS-HOST:6379/0

# ---- GitHub (raises the public API's rate limit; works without it too) ----
GITHUB_TOKEN=

REQUEST_TIMEOUT_SECONDS=15
