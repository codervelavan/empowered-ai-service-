# ---- Server ----
NODE_ENV=development
PORT=4200
CORS_ORIGIN=http://localhost:4000

# ---- Auth (inbound) ----
# Shared secret callers (Portal, Frappe) present as `Authorization: Bearer <token>`.
# This service is internal-only — never expose it publicly.
SERVICE_AUTH_TOKEN=change-me-to-a-long-random-string

# ---- OpenAI ----
# "Codex" is OpenAI's coding-agent product line, not a model you call for
# candidate evaluation — this targets the standard Chat/Responses API on a
# GPT-4-class model instead (what people mean by "ChatGPT" for API use).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Used only for the final consolidated hiring report; falls back to
# OPENAI_MODEL if unset. A stronger model is worth it for the one call that
# actually produces the stored evaluation.
OPENAI_CONSOLIDATION_MODEL=gpt-4o

# ---- GitHub (optional — raises the public API's low unauthenticated rate limit) ----
GITHUB_TOKEN=

# ---- Portal callback (candidate hiring-evaluation results are pushed async) ----
PORTAL_BASE_URL=http://localhost:4000
# Must equal the Portal's WEBHOOK_SECRET (server/.env) — this service is
# just another caller of the existing, already-tested
# POST /api/webhooks/ai-evaluation contract.
PORTAL_WEBHOOK_SECRET=change-me-webhook-secret
