# FastAPI/Celery service configuration. Keep real values in an ignored secret file.
SERVICE_AUTH_TOKEN=legacy-fallback-token
PORTAL_AUTH_TOKEN=portal-to-ai-token
FRAPPE_AUTH_TOKEN=frappe-to-ai-token
PORTAL_CALLBACK_URL=https://portal.example/api/webhooks/ai-evaluation
PORTAL_CALLBACK_SECRET=replace-with-a-rotated-callback-secret
OPENAI_API_KEY=
# Leave blank for real OpenAI. Set to https://openrouter.ai/api/v1 to route
# through OpenRouter instead (whose keys start `sk-or-v1-`).
OPENAI_BASE_URL=
AI_PROVIDER=real
OPENAI_SPECIALIST_MODEL=gpt-4o-mini
OPENAI_CONSOLIDATION_MODEL=gpt-4o-mini
# Retried once, only on a structured-output compliance failure. See
# evaluation.py's _json_completion.
OPENAI_FALLBACK_MODEL=gpt-4o-mini
REDIS_URL=redis://redis:6379/0
GITHUB_TOKEN=
REQUEST_TIMEOUT_SECONDS=15
